<configuration>
  <configSections>
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
    <section name="Admin_AutoFollowBetSection" type="Fanex.BetFollow.Infrastructure.Configurations.Admin_AutoFollowBetSection, Fanex.BetFollow.Infrastructure, Version=1.0.0.0, Culture=neutral" />
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <sectionGroup name="jsEngineSwitcher">
      <section name="core" type="JavaScriptEngineSwitcher.Core.Configuration.CoreConfiguration, JavaScriptEngineSwitcher.Core" />
      <section name="msie" type="JavaScriptEngineSwitcher.Msie.Configuration.MsieConfiguration, JavaScriptEngineSwitcher.Msie" />
    </sectionGroup>
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <sectionGroup name="bundleTransformer">
      <section name="core" type="BundleTransformer.Core.Configuration.CoreSettings, BundleTransformer.Core" />
      <section name="less" type="BundleTransformer.Less.Configuration.LessSettings, BundleTransformer.Less" />
    </sectionGroup>
  </configSections>
  <Admin_AutoFollowBetSection configSource="Configurations\Admin_AutoFollowBetSection.config" />
  <NapSettings
      Environment="LIVE"
      EnableDirectLogin="1"
      SiteId="23"
      UnauthorizeUrl="~/Common/AccessDenied"
      EnableReCheckin="true"
      HubUrl=""
      ServiceUrls="http://10.40.40.22:1710/api"
      AccessKey="pFAusxCAVfeyhzyMuTvm62hJ+Rdw+9yEQAaZQaUTcag=" >
    <Domain>
      <add Name="nap.oneops.net" Path="/NAPBF" />
    </Domain>
  </NapSettings>
  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api"
              EnableCheckUM="true"
              EnableUnscheduledUM="false"
              UMFrom="01:00"
              UMTo="23:00"
              SiteId="2000000" UMPageUrl="~/Common/Offline">
    <AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" />
      <!--Exact IP-->
      <add From="10.19.10.100" To="10.19.10.200" />
      <!--IP Range-->
    </AllowedIPs>
  </ONEbook.UM>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider"
           type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data"
           resourcePath="~/Configurations/Dev.StoreProcedure"
           enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.22\private$\entlib" defaultCategory="BF-PRO" />
  <connectionStrings configSource="ConnectionStrings.config" />
  <appSettings file="Web.Setting.config">
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="app_mail_id" value="1" />
    <add key="app_mail_address" value="net.tcp://10.40.40.22:8585/MailService" />
  </appSettings>
  <system.web>
    <customErrors mode="On" defaultRedirect="~/Common/ErrorPage">
      <error statusCode="404" redirect="~/Views/Common/404Error.htm" />
    </customErrors>
    <compilation debug="true" targetFramework="4.6.1" />
    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40"
			loginUrl="~/UserLogin/SignIn"
			defaultUrl="~/Home/Default"
			timeout="25"
			name=".BETFOLLOWASPXAUTH"
			slidingExpiration="true"
			path="/" />
    </authentication>
    <sessionState mode="StateServer" cookieName=".BetFollow_ASP.NET_SessionId" cookieless="false" timeout="30" stateConnectionString="tcpip=10.40.40.22:42424" />
    <machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB" decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65" validation="SHA1" decryption="AES" />
    <httpRuntime maxRequestLength="1048576" executionTimeout="3600" maxUrlLength="1048576" maxQueryStringLength="1048576" relaxedUrlToFileSystemMapping="true" />
    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <caching>
      <profiles>
        <add extension=".ico" policy="CacheForTimePeriod" kernelCachePolicy="DontCache" duration="12:00:00" />
        <add extension=".js" policy="CacheForTimePeriod" kernelCachePolicy="DontCache" duration="12:00:00" />
        <add extension=".less" policy="CacheForTimePeriod" kernelCachePolicy="DontCache" duration="12:00:00" />
        <add extension=".png" policy="CacheForTimePeriod" kernelCachePolicy="DontCache" duration="12:00:00" />
        <add extension=".gif" policy="CacheForTimePeriod" kernelCachePolicy="DontCache" duration="12:00:00" />
      </profiles>
    </caching>
    <staticContent>
      <clientCache cacheControlMode="UseExpires" httpExpires="Tue, 31 Dec 2030 00:00:00 GMT" />
    </staticContent>
    <handlers>
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" />
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness32" responseBufferLimit="0" />
      <add name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework64\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness64" responseBufferLimit="0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
      <add name="LessAssetHandler" path="*.less" verb="GET" type="BundleTransformer.Less.HttpHandlers.LessAssetHandler, BundleTransformer.Less" resourceType="File" preCondition="" />
    </handlers>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http" publicKeyToken="31bf3856ad364e35" />
