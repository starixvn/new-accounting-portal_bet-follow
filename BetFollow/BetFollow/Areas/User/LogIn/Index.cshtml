<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta charset="utf-8" />
    <title>@Resources.Labels.Sign_In</title>
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/Areas/User/LogInStyles")
</head>
<body>
    <div id='not-supported-browser-panel' style="display: none">
        Your browser is no longer supported. Some parts will not work and you may experience
        problems.<br />
        If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full
        browsing experience. Thank you!
    </div>
    <div class="center">
        <div id="login-box">
            <div id="msg">
                <span id="inner-msg">@ViewBag.Message</span>
            </div>
            <div class="header">
                <div class="welcome">
                </div>
                <div class="secure">
                </div>
            </div>
            <div class="auth">
                <form action="@Url.Content("~/UserLogin/Index")" method="POST" id="frmLogin" name="frmLogin">
                @Html.AntiForgeryToken()
                <input id="loginToken" name="loginToken" value="@ViewBag.LoginToken" type ="hidden" />
                <input type="text" id="username" name="username" autocomplete="off" />
                <input type="password" id="password" name="password" />
                <input type="button" id="btnLogin" value="@Resources.Labels.Sign_In" 
                    onclick="LoginManager.doLogin();"/>
                <div class="bestview">
                </div>
                </form>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="~/Scripts/jquery.js"></script>
    <script type="text/javascript" src="~/Scripts/JQuery/jquery-1.8.2.js"></script>
    <script type="text/javascript" src="~/Scripts/ShareScripts/SharedScriptManager.js"></script>
    <script type="text/javascript" src="~/Scripts/CryptoJS.js"></script>
    <script type="text/javascript" src="~/Areas/User/LogIn/Scripts/LogInManager.js"></script>
</body>
</html>
