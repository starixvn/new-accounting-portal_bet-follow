@using Fanex.BetFollow.Module.AutoFollowBet.Resources;
@using Fanex.BetFollow.Infrastructure.Constants;
@using Fanex.BetFollow.Infrastructure.Configurations;
@{
    ViewBag.Title = Labels.Auto_Follow_Bet;
    var minRate = Admin_AutoFollowBetSection.Instance.Configs["Rate"].Min;
    var maxRate = Admin_AutoFollowBetSection.Instance.Configs["Rate"].Max;
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/site/common")
    @Styles.Render("~/Styles/FanexMultipleSelect")
    @Styles.Render("~/Styles/FanexGridStyles")
    @Styles.Render("~/Areas/AutoFollowBet/ManageListStyles")
</head>
<body>
    <div class="main container">
        <div class="row filter-frm one-row">
            <div class="row row-item">
                <div class="item">
                    <label for="textbox-username">
                        @Labels.Username</label>
                </div>
                <div class="item">
                    <input id="textbox-username" type="text" class="textbox textbox-username" maxlength="50" />
                </div>
                <div class="item">
                    <label for="dropdown-customer">
                        @Labels.Customer</label>
                </div>
                <div class="item">
                    <select id="dropdown-customer">
                        <option value="%">@Labels.All</option>
                        <option value="@CustomerConstants.Agent">@Labels.Agent</option>
                        <option value="@CustomerConstants.Member">@Labels.Member</option>
                    </select>
                </div>
                <div class="item">
                    <label for="dropdown-source">
                        @Labels.Source</label>
                </div>
                <div class="item">
                    <select id="dropdown-source">
                        <option value="%">@Labels.All</option>
                        <option value="@SourceTypeConstants.Auto">@Labels.Auto</option>
                        <option value="@SourceTypeConstants.Manual">@Labels.Manual</option>
                    </select>
                </div>
                <div class="item">
                    <label for="dlStatus">
                        @Labels.BA_Status</label>
                </div>
                <div class="item">
                    <select id="dlStatus">
                        <option value="%">@Labels.All</option>
                        <option value="@BAStatusConstants.BAEnabled">@Labels.BA_Enabled</option>
                        <option value="@BAStatusConstants.BADisabled">@Labels.BA_Disabled</option>
                    </select>
                </div>
                <div class="item">
                    <label for="dropdown-followtype">
                        @Labels.Follow_Type</label>
                </div>
                <div class="item">
                    <div id="dropdown-followtype">
                    </div>
                </div>
                <div class="item">
                    <label for="textbox-follower">
                        @Labels.Follower</label>
                </div>
                <div class="item">
                    <input id="textbox-follower" type="text" class="textbox" maxlength="50" />
                </div>
                <div class="item">
                    <button id="button-submit" class="btn" onclick="autoFollowBet.GetAutoFollowedBet();">
                        @Labels.Submit</button>
                </div>
            </div>
        </div>
        <div id="errormessage" class="errMsg display-none">
            <div>
            </div>
        </div>
        <div id="autofollowbet-grid" class="content-warper display-none">
            <div class="content-toolbox bgtitle">
                <div id="gridTitle" class="gridtitle">
                </div>
                <div class="btngroup">
                    <input id="button-addnewfollowedcustomer" type="button" value="  " name="btnAdd"
                        class="btnAdd" title="@Labels.Add_Exist_Customer" />
                </div>
                <div class="btngroup">
                    <input id="button-removefollowedcustomer" type="button" value="  "
                        class="btnDel" title="@Labels.Delete" />
                </div>
            </div>
            <div class="content-header clearfix">
                <div class="header-scroll">
                    <table class="tbl-header-scroll">
                        <tr>
                            <td class="title2">
                                <div class="col120 c">
                                    @Labels.Username
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col80 c">
                                    @Labels.Source
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col80 c">
                                    @Labels.Rate
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col90 c">
                                    @Labels.Live/ @Labels.Non_Live
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col80 c">
                                    (+/-)@Labels.Odds
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col60 c">
                                    @Labels.HDP
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col60 c">
                                    @Labels._1st_HDP
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col60 c">
                                    @Labels.Symbol_OU
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col60 c">
                                    @Labels.Symbol_1stOU
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col120 c">
                                    @Labels.Follower
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col70 c">
                                    @Labels.BA_Status
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col70 c">
                                    @Labels.Agent
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col70 c">
                                    @Labels.Edit
                                </div>
                            </td>
                            <td class="title2">
                                <div class="col50 c">
                                    @Labels.Delete
                                </div>
                            </td>
                            <td class="title2">
                                <div class="c" style="width: 44px">
                                    <input type="checkbox" id="chkAll" />
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="content-body clearfix">
                <div class="body-scroll">
                    <table class="tbl-body-scroll">
                        <tbody id="autofollowbet-gridbody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="content-pagination bgtitle clearfix">
                <div class="pagination-scroll">
                    <table style="width: 100%" cellspacing="0" cellpadding="1">
                        <tr>
                            <td>
                                <div id="pagination" class="pagination">
                                    &nbsp;</div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div id="dialog-addnewfollowedcustomer" class="display-none">
            <div id="resultmessage-adddialog">
                <div>
                </div>
            </div>
            <div>               
                <table>
                    <tr>
                        <td>
                            <div class="col60 r">
                                @Labels.Username
                            </div>
                        </td>
                        <td>
                            <div class="col172">
                                <div style="float: left"><input id="textbox-username-addnewdialog" type="text" maxlength="50" /></div><span title="@Labels.AddCustomer" id="addCust" class="add-cust">&nbsp;</span>
                            </div>
                        </td>
                        <td>
                            <div class="col40 r">
                                @Labels.Rate
                            </div>
                        </td>
                        <td>
                            <div class="col90">
                                <input id="textbox-rate-addnewdialog" type="text" maxlength="4" class="c" />
                            </div>
                        </td>
                        <td>
                            <div class="col60 r">
                                @Labels.Follower
                            </div>
                        </td>
                        <td>
                            <div class="col120">
                                <input id="textbox-follower-addnewdialog" type="text" maxlength="50" class="c" />
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td>
                            <div id="custList" class="cust-list"></div>
                        </td>
                        <td colspan="5" valign="top" align="left">
                            <table class="filter-adddialog addAutoFollowBetForm">
                                <tr>
                                    <td class="title2">
                                        <div class="col100 c">
                                        </div>
                                    </td>
                                    <td class="title2">
                                        <div class="col100 c">
                                            (+/-)@Labels.Odds
                                        </div>
                                    </td>
                                    <td class="title2">
                                        <div class="col60 c">
                                            @Labels.HDP
                                        </div>
                                    </td>
                                    <td class="title2">
                                        <div class="col60 c">
                                            @Labels._1st_HDP
                                        </div>
                                    </td>
                                    <td class="title2">
                                        <div class="col60 c">
                                            @Labels.Symbol_OU
                                        </div>
                                    </td>
                                    <td class="title2">
                                        <div class="col60 c">
                                            @Labels.Symbol_1stOU
                                        </div>
                                    </td>
                                </tr>
                                <tr class="followedNoneLive">
                                    <td>
                                        <div class="col100 c">
                                            @Labels.Non_Live</div>
                                    </td>
                                    <td>
                                        <div class="col100 c">
                                            <select id="dropdown-nonelive-odds-adddialog" class="ddlNoneLiveOdds">
                                                <option value="0.1">0.1</option>
                                                <option value="0.09">0.09</option>
                                                <option value="0.08">0.08</option>
                                                <option value="0.07">0.07</option>
                                                <option value="0.06">0.06</option>
                                                <option value="0.05">0.05</option>
                                                <option value="0.04">0.04</option>
                                                <option value="0.03">0.03</option>
                                                <option value="0.02">0.02</option>
                                                <option value="0.01">0.01</option>
                                                <option value="0" selected="selected">0</option>
                                                <option value="-0.01">-0.01</option>
                                                <option value="-0.02">-0.02</option>
                                                <option value="-0.03">-0.03</option>
                                                <option value="-0.04">-0.04</option>
                                                <option value="-0.05">-0.05</option>
                                                <option value="-0.06">-0.06</option>
                                                <option value="-0.07">-0.07</option>
                                                <option value="-0.08">-0.08</option>
                                                <option value="-0.09">-0.09</option>
                                                <option value="-0.1">-0.1</option>
                                            </select>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="hdpstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="_1sthdpstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="overunderstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="_1stoverunderstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                </tr>
                                <tr class="followedLive">
                                    <td>
                                        <div class="col100 c">
                                            @Labels.Live</div>
                                    </td>
                                    <td>
                                        <div class="col100 c">
                                            <select id="dropdown-live-odds-adddialog" class="ddlLiveOdds">
                                                <option value="0.1">0.1</option>
                                                <option value="0.09">0.09</option>
                                                <option value="0.08">0.08</option>
                                                <option value="0.07">0.07</option>
                                                <option value="0.06">0.06</option>
                                                <option value="0.05">0.05</option>
                                                <option value="0.04">0.04</option>
                                                <option value="0.03">0.03</option>
                                                <option value="0.02">0.02</option>
                                                <option value="0.01">0.01</option>
                                                <option value="0" selected="selected">0</option>
                                                <option value="-0.01">-0.01</option>
                                                <option value="-0.02">-0.02</option>
                                                <option value="-0.03">-0.03</option>
                                                <option value="-0.04">-0.04</option>
                                                <option value="-0.05">-0.05</option>
                                                <option value="-0.06">-0.06</option>
                                                <option value="-0.07">-0.07</option>
                                                <option value="-0.08">-0.08</option>
                                                <option value="-0.09">-0.09</option>
                                                <option value="-0.1">-0.1</option>
                                            </select>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="hdpstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="_1sthdpstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="overunderstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="col60 c">
                                            <input class="_1stoverunderstatus chkBox" type="checkbox" checked="checked" />
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="6" style="border: none !important">
                                        <div class="c" style="margin-top: 20px">
                                            <input id="buttonsubmit-addnewdialog" type="button" value="@Labels.Submit" class="btn" />
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>                    
                </table>
            </div>            
        </div>
    </div>
    @Scripts.Render("~/Views/CommonScripts")
    @Scripts.Render("~/Scripts/FanexMultipleSelect")
    @Scripts.Render("~/Scripts/FanexGridScripts")
    @Scripts.Render("~/Areas/AutoFollowBet/ManageListScripts")
    <script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';  
        jQuery.curCSS = jQuery.css;  
        var viewResources = {
            minRate : @minRate,
            maxRate : @maxRate,
            Add_New_Followed_Customer: '@Labels.Add_New_Followed_Customer',
            All: '@Labels.All',
            No_type_found: '@Labels.No_type_found',

            Error_Admin_AutoFollowBetManagement_LiveStatus_Empty: '@Labels.Error_Admin_AutoFollowBetManagement_LiveStatus_Empty',
            Error_Admin_AutoFollowBetManagement_HDPStatus_Empty: '@Labels.Error_Admin_AutoFollowBetManagement_HDPStatus_Empty',
            Error_Admin_AutoFollowBetManagement_1stHDPStatus_Empty: '@Labels.Error_Admin_AutoFollowBetManagement_1stHDPStatus_Empty',
            Error_Admin_AutoFollowBetManagement_OverUnderStatus_Empty: '@Labels.Error_Admin_AutoFollowBetManagement_OverUnderStatus_Empty',
            Error_Admin_AutoFollowBetManagement_1stOverUnderStatus_Empty: '@Labels.Error_Admin_AutoFollowBetManagement_1stOverUnderStatus_Empty',
    
            Save: '@Labels.Save',
            Cancel: '@Labels.Cancel',
            Edit: '@Labels.Edit',
            Delete: '@Labels.Delete',
            Both: '@Labels.Both',
            Live: '@Labels.Live',
            Non_Live: '@Labels.Non_Live',

            Warning_Admin_AutoFollowBetManagement_DeleteFollowInfo: '@Labels.Warning_Admin_AutoFollowBetManagement_DeleteFollowInfo',
            Success_Admin_AutoFollowBetManagement_DeleteFollowInfo: '@Labels.Success_Admin_AutoFollowBetManagement_DeleteFollowInfo',
            No_Info: '@Labels.No_Info',

            Error_Admin_AutoFollowBetManagement_InvalidRate_Empty:'@Labels.Error_Admin_AutoFollowBetManagement_InvalidRate_Empty',
            Error_Admin_AutoFollowBetManagement_InvalidRate_Number: '@Labels.Error_Admin_AutoFollowBetManagement_InvalidRate_Number',
            Error_Admin_AutoFollowBetManagement_InvalidRate_Range: '@string.Format(Labels.Error_Admin_AutoFollowBetManagement_InvalidRate_Range, Math.Round(minRate, 2), maxRate)',
            Error_Admin_AutoFollowBetManagement_InvalidRate_DecimalDigit:'@Labels.Error_Admin_AutoFollowBetManagement_InvalidRate_DecimalDigit',
            Success_Admin_AutoFollowBetManagement_UpdateFollowInfo:'@Labels.Success_Admin_AutoFollowBetManagement_UpdateFollowInfo',
       
            Error_Admin_AutoFollowBetManagement_Username_Empty:'@Labels.Error_Admin_AutoFollowBetManagement_Username_Empty',
            Success_Admin_AutoFollowBetManagement_AddFollowInfo: '@Labels.Success_Admin_AutoFollowBetManagement_AddFollowInfo',
            Error_Admin_AutoFollowBetManagement_InvalidFollower_Empty:'@Labels.Error_Admin_AutoFollowBetManagement_InvalidFollower_Empty',
            NoPermission: '@Labels.NoPermission',
            AlreadyAdded: '@Labels.AlreadyAdded'
        };
    </script>
</body>
</html>
